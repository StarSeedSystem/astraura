{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://astraura-backend-334237619848.us-central1.run.app/api/$1"
    },
    {
      "source": "/active_tunnel.json",
      "destination": "https://astraura-backend-334237619848.us-central1.run.app/active_tunnel.json"
    }
  ]
}
